{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "**"
    }
  },
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/index?__lg_path=/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "env": {
    "LEADGEN_QUEUE": "always",
    "LEADGEN_DATA_DIR": "/tmp/leadgen-data",
    "LEADGEN_ROOT_UI": "nova"
  }
}
