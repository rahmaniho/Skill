# ── نمونه تنظیمات — کپی کنید به .env و فقط آنچه لازم دارید را تغییر دهید ──
#   cp .env.example .env
# هیچ کلید API لازم نیست. همه‌چیز روی دستگاه خودتان اجرا می‌شود.

# ── موتور اسکراپر (کیت اصلی: gosom/google-maps-scraper داخل داکر) ────────────
# پورت موتور روی میزبان. اگر ۸۰۸۰ اشغال است تغییرش دهید و دوباره docker compose up -d بزنید.
SCRAPER_PORT=8080

# آدرس کامل API موتور. فقط وقتی موتور جای دیگری است تنظیمش کنید.
# SCRAPER_BASE_URL=http://localhost:8080

# هدر X-API-Key. برای استفاده محلی خالی است (درست). فقط اگر موتور را با پراکسی احراز هویت
# بیرون از localhost برده‌اید پرش کنید.
SCRAPER_API_KEY=

# ── حالت موتور ───────────────────────────────────────────────────────────────
# auto  = اول موتور واقعی (داکر) را چک می‌کند، اگر در دسترس نبود به حالت دمو می‌رود
# docker= فقط موتور واقعی روی localhost:8080
# demo  = موتور شبیه‌ساز داخلی (بدون داکر/بدون اینترنت) برای تست و آموزش کامل پایپ‌لاین
ENGINE_MODE=auto

# ── سرویس وب (داشبورد) ───────────────────────────────────────────────────────
# روی 0.0.0.0 بایند می‌شود تا در پیش‌نمایش زنده و شبکه محلی دیده شود.
LEADGEN_HOST=0.0.0.0
LEADGEN_PORT=8000

# پوشه داده‌ها (پایگاه‌داده + خروجی فایل‌ها)
LEADGEN_DATA_DIR=data

# ── غنی‌سازی ─────────────────────────────────────────────────────────────────
# تعداد رشته‌های موازی برای واکشی سایت کسب‌وکارها (ایمیل عمیق + شبکه‌های اجتماعی)
ENRICH_WORKERS=8

# ── پراکسی (اختیاری؛ برای اجراهای بزرگ و پشت‌سرهم تا IP موقتاً محدود نشود) ────
# با کاما جدا کنید. نمونه: socks5://user:pass@host:port,http://host2:port2
SCRAPER_PROXIES=

# ══════════════════════════════════════════════════════════════════════════════
# لایهٔ عملیاتی (ابر): اپ روی Vercel + پایگاه‌دادهٔ Supabase + موتور در Codespaces
# همهٔ بخش‌های زیر اختیاری‌اند؛ بدون آن‌ها برنامه همان‌طور که بود محلی کار می‌کند.
# ══════════════════════════════════════════════════════════════════════════════

# ── پایگاه‌دادهٔ ابری (Supabase / Postgres) ───────────────────────────────────
# وقتی این دو پر باشند، DB_BACKEND خودش «supabase» می‌شود و همهٔ داده‌ها (اجراها،
# لیدها، صف، گزارش ایمیل‌ها) در پایگاه‌دادهٔ مشترک ذخیره می‌شوند — یعنی اپِ Vercel و
# ورکرِ Codespaces یک داده را می‌بینند.
#   SUPABASE_URL          = Project Settings → API → Project URL
#   SUPABASE_SERVICE_KEY  = همان‌جا → service_role (کلید محرمانه؛ هرگز در مرورگر نگذارید)
# قبل از اولین استفاده، supabase/schema.sql را یک‌بار در SQL Editor اجرا کنید.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_ANON_KEY=
# SUPABASE_SCHEMA=public
# LEADGEN_DB=supabase|sqlite     # اجبار دستی پشتیبان (پیش‌فرض: خودکار)

# ── صف اجراها (ورکر جدا از وب) ────────────────────────────────────────────────
# auto   = وقتی پایگاه‌داده ابری است یا LEADGEN_WORKER=1، اجراها به صف می‌روند
# always = همیشه صف (حالت سرورلس Vercel: تابع نمی‌تواند چند دقیقه باز بماند)
# never  = اجرای همزمان داخل همان فرایند (حالت محلی/تک‌کاربره)
LEADGEN_QUEUE=auto
# LEADGEN_WORKER=1               # روی ماشین ورکر (Codespace) بگذارید
WORKER_ID=worker-codespace
WORKER_POLL_SECONDS=5
WORKER_MAX_JOBS=0                # ۰ = نامحدود
WORKER_MAX_ATTEMPTS=3            # تلاش مجدد پیش از «ناموفق»

# ── نشانی اپ (برای لینک‌های داخل ایمیل) ──────────────────────────────────────
# APP_BASE_URL=https://your-app.vercel.app

# ── تحویل خروجی: ایمیل (Gmail) ────────────────────────────────────────────────
# گیرنده‌های گزارش لیدهای داغ (با کاما جدا کنید)
DIGEST_TO=
# DIGEST_FROM=you@gmail.com
# DIGEST_MAX_LEADS=12
#
# مسیر ۱ — Gmail API (تنها راه روی Vercel؛ خروجی SMTP در serverless بسته است):
#   در console.cloud.google.com یک OAuth Client (Desktop) بسازید، scopes:
#   gmail.send + gmail.compose، سپس refresh token بگیرید (scripts/gmail_token.py).
# GMAIL_REFRESH_TOKEN=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
#
# مسیر ۲ — SMTP با «رمز برنامه» (روی Codespace/ماشین خودتان ساده‌ترین راه):
#   Gmail → Security → 2-Step Verification → App passwords
# GMAIL_SENDER=you@gmail.com
# GMAIL_APP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
#
# LEADGEN_DELIVERY_DRY=1         # فقط فایل .eml بساز، چیزی ارسال نکن (بازبینی/تست)
# LEADGEN_ROOT_UI=nova             # رابط پیش‌فرض روی «/»: nova (نسل بعد) | smart | mini

# ── موتور واقعی بدون داکر (اجرای زنده روی Vercel) ────────────────────────────
# ENGINE_MODE=auto   # auto → داکر → Places (اگر کلید) → OpenStreetMap → دمو
# OSM_ENDPOINT=https://nominatim.openstreetmap.org
# OSM_LIMIT=40                            # حداکثر نتیجه در هر کوئری
# OSM_MIN_INTERVAL=1.1                    # فاصلهٔ حداقلی بین درخواست‌ها (سیاست OSM)
# OSM_COUNTRY=ir
# PLACES_API_KEY=                         # اختیاری — Google Places API (مسیر تجاری)
# SELF_DRIVE=1                            # رابط خودش صف را اجرا کند (بدون ورکر)

# ── محافظ‌های تجاری ──────────────────────────────────────────────────────────
# LEADGEN_ACCESS_CODE=                    # اگر بگذارید، اپ با کد قفل می‌شود
# LEADGEN_MAX_PENDING=3                   # سقف کارهای در صف
# LEADGEN_RATE_RUNS=30                    # سقف اجرا در ساعت به‌ازای IP
