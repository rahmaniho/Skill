# ── نمونه تنظیمات — کپی کنید به .env و فقط آنچه لازم دارید را تغییر دهید ──
#   cp .env.example .env
# هیچ کلید API لازم نیست. همه‌چیز روی دستگاه خودتان اجرا می‌شود.

# ── موتور اسکراپر (کیت اصلی: gosom/google-maps-scraper داخل داکر) ────────────
# پورت موتور روی میزبان. اگر ۸۰۸۰ اشغال است تغییرش دهید و دوباره docker compose up -d بزنید.
SCRAPER_PORT=8080

# آدرس کامل API موتور. فقط وقتی موتور جای دیگری است تنظیمش کنید.
# SCRAPER_BASE_URL=http://localhost:8080

# هدر X-API-Key. برای استفاده محلی خالی است (درست). فقط اگر موتور را با پراکسی احراز هویت
# بیرون از localhost برده‌اید پرش کنید.
SCRAPER_API_KEY=

# ── حالت موتور ───────────────────────────────────────────────────────────────
# auto  = اول موتور واقعی (داکر) را چک می‌کند، اگر در دسترس نبود به حالت دمو می‌رود
# docker= فقط موتور واقعی روی localhost:8080
# demo  = موتور شبیه‌ساز داخلی (بدون داکر/بدون اینترنت) برای تست و آموزش کامل پایپ‌لاین
ENGINE_MODE=auto

# ── سرویس وب (داشبورد) ───────────────────────────────────────────────────────
# روی 0.0.0.0 بایند می‌شود تا در پیش‌نمایش زنده و شبکه محلی دیده شود.
LEADGEN_HOST=0.0.0.0
LEADGEN_PORT=8000

# پوشه داده‌ها (پایگاه‌داده + خروجی فایل‌ها)
LEADGEN_DATA_DIR=data

# ── غنی‌سازی ─────────────────────────────────────────────────────────────────
# تعداد رشته‌های موازی برای واکشی سایت کسب‌وکارها (ایمیل عمیق + شبکه‌های اجتماعی)
ENRICH_WORKERS=8

# ── پراکسی (اختیاری؛ برای اجراهای بزرگ و پشت‌سرهم تا IP موقتاً محدود نشود) ────
# با کاما جدا کنید. نمونه: socks5://user:pass@host:port,http://host2:port2
SCRAPER_PROXIES=
