{
  "name": "LeadGen — موتور واقعی + ورکر صف",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",

  "//": "داکر داخل Codespace لازم است تا موتور gosom/google-maps-scraper بالا بیاید.",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true,
      "installDockerBuildx": true
    }
  },

  "forwardPorts": [8000, 8080],
  "portsAttributes": {
    "8000": { "label": "داشبورد LeadGen", "onAutoForward": "notify" },
    "8080": { "label": "موتور اسکراپر (localhost)", "visibility": "private", "onAutoForward": "ignore" }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-worker.sh",

  "remoteEnv": {
    "PYTHONUNBUFFERED": "1",
    "LEADGEN_WORKER": "1"
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "files.associations": { "*.sql": "sql" }
      }
    }
  }
}
